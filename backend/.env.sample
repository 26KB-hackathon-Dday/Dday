# 이 파일을 .env로 복사해서 쓴다:  cp .env.sample .env
# .env는 커밋되지 않는다(.gitignore).
#
# 아래 값은 로컬 개발 전용 기본값이며 backend/src/main/resources/application-local.yml과
# 짝이 맞다. 한쪽을 고치면 다른 쪽도 고쳐야 한다.

MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=dday
MYSQL_USER=dday
MYSQL_PASSWORD=dday1234

# 3306이 이미 쓰이고 있으면 여기만 바꾸고, application-local.yml의 URL 포트도 같이 고친다.
MYSQL_PORT=3306

# ── 여기부터는 서버(EC2)의 .env에만 넣는다. 로컬에서는 안 쓴다 ──────────────
# 로컬은 위의 docker compose MySQL에 붙고, 서버는 RDS에 붙는다.
#
# DB_HOST: RDS 엔드포인트. 포트(:3306)와 jdbc: 접두사는 빼고 호스트만 적는다.
#          예) dday-db.abcdefghijk.ap-northeast-2.rds.amazonaws.com
DB_HOST=
DB_NAME=dday
DB_USERNAME=admin
DB_PASSWORD=

# 배포된 프론트 주소. 여러 개면 쉼표로 잇는다. 비우면 전부 허용된다.
CORS_ALLOWED_ORIGINS=

# JWT 서명키.
#
# 서버(EC2)에서는 손댈 필요가 없다 — 배포 워크플로가 .env에 없으면 한 번 만들어 넣는다
# (.github/workflows/ci.yml의 "Pull & restart"). 값이 이미 있으면 그대로 둔다.
# 로컬은 아래 줄을 주석으로 둔 채 application.yml의 기본값을 쓴다. 손댈 일이 없다.
#
# ⚠️ 값 없이 `JWT_SECRET=` 만 적으면 안 된다. build.gradle이 .env를 환경변수로 넘기는데,
#    빈 문자열도 "설정된 값"이라 application.yml의 기본값을 덮어버리고 기동이 깨진다.
#    쓰지 않을 거면 줄 전체를 주석 처리한다.
#
# ⚠️ 서버의 이 값을 바꾸면 이미 발급된 토큰이 전부 무효가 되어 사용자가 로그아웃된다.
#JWT_SECRET=
