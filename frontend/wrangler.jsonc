{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ⚠️ 이 이름은 Cloudflare 대시보드의 Worker 이름과 반드시 같아야 한다.
  // 다르면 Workers Builds가 배포 단계에서 실패한다.
  // 현재 배포 주소: https://dday.26kb.workers.dev
  "name": "dday",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  "assets": {
    // vite build 결과물
    "directory": "./dist",
    // Worker 코드에서 env.ASSETS로 접근한다
    "binding": "ASSETS",
    // SPA라서 /some/deep/link 같은 경로도 index.html을 돌려줘야 한다.
    // 없으면 새로고침할 때마다 404가 난다.
    "not_found_handling": "single-page-application",
    // 기본값은 "정적 파일이 있으면 Worker를 건너뛴다"인데,
    // /api/* 는 정적 파일이 아니므로 Worker가 먼저 봐야 한다.
    "run_worker_first": ["/api/*", "/health", "/health/*"]
  },

  "vars": {
    // 백엔드 EC2. 이 값만 바꾸면 프론트 코드를 안 고치고 백엔드를 옮길 수 있다.
    //
    // ⚠️ **생 IP(http://43.203.100.35)를 쓰면 안 된다.** 배포된 Worker에서 IP로 fetch하면
    // Cloudflare가 `error code: 1003 Direct IP access not allowed`로 403을 준다.
    // 로컬 `wrangler dev`에서는 내 컴퓨터가 직접 fetch하므로 멀쩡히 동작해서
    // 배포하고 나서야 드러난다 — 실제로 그렇게 한 번 당했다.
    //
    // 이 호스트명에는 IP가 박혀 있다(ec2-3-36-106-81-...). 인스턴스를 stop/start하면
    // IP가 바뀌고 이 이름도 같이 바뀌므로 그때 여기를 고쳐야 한다.
    // (고정하려면 Elastic IP를 붙인다 — docs/deploy.md 참고)
    "BACKEND_ORIGIN": "http://ec2-43-203-100-35.ap-northeast-2.compute.amazonaws.com"
  },

  "observability": { "enabled": true }
}
